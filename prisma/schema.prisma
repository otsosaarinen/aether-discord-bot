generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sheet {
  sheet_id String @id @unique
}

model Player {
  id Int @id @unique @default(autoincrement())
  osu_id  Int @unique
  osu_username String @unique
  discord_id String? 
  discord_username String?
  rank Int
  country String
  osuOauthDone Boolean @default(false)
  discordOauthDone Boolean @default(false)
  createdAt DateTime @default(now())
}

model OauthState {
  id        String   @id @default(uuid())
  state     String   @unique
  provider String
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
}