// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sheet {
  sheet_id Int @id
}

model Player {
  osu_id  Int @id 
  osu_username String
  discord_user_id Int
  discord_username String
  createdAt DateTime
}