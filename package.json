		"@mui/material": "^7.1.1",
		"@prisma/client": "^6.9.0",
		"@prisma/extension-accelerate": "^2.0.1",
		"@tailwindcss/vite": "^4.1.10",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"discord.js": "^14.19.3",
		"dotenv": "^16.5.0",
		"express": "^5.1.0",
		"googleapis": "^105.0.0",
		"jsonwebtoken": "^9.0.2",
		"nodemon": "^3.1.10",
		"prisma": "^6.9.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.6.2",
		"tailwindcss": "^4.1.10",
