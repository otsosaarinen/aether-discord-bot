{
	"name": "aether-discord-bot",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"deploy_commands": "npx tsx src/deploy-commands.ts",
		"bot": "npx nodemon --watch src --exec \"tsx\" src/index.ts",
		"server": "npx tsx src/server/index.ts"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@google-cloud/local-auth": "^2.1.0",
